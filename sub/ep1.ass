Dialogue: 0,0:00:01.80,0:00:03.50,Original,,0,0,0,,TẬP 1
Dialogue: 0,0:02:00.48,0:02:01.70,Original,,0,0,0,,Tiểu thư
Dialogue: 0,0:02:02.45,0:02:05.90,Original,,0,0,0,,Tiểu thư Anilthita\N Người đang ở đâu vậy
Dialogue: 0,0:02:55.80,0:02:59.52,Original,,0,0,0,,Tiểu thư
Dialogue: 0,0:03:02.24,0:03:06.70,Original,,0,0,0,,Tiểu thư\NSao người có thể trốn ra tận nơi này được chứ
Dialogue: 0,0:03:07.40,0:03:08.86,Original,,0,0,0,,Mau quay về thôi tiểu thư ơi
Dialogue: 0,0:03:09.66,0:03:12.14,Original,,0,0,0,,Chị vú nuôi Bandasa đang tìm người khắp nơi đó
Dialogue: 0,0:03:14.38,0:03:18.10,Original,,0,0,0,,Mau lên đi ạ, tiểu thư Anilthita
Dialogue: 0,0:03:29.26,0:03:30.78,Original,,0,0,0,,Anilthita
Dialogue: 0,0:03:37.74,0:03:39.86,Original,,0,0,0,,Trưa hôm nay tiểu thư lại trốn ra ngoài chơi nữa đúng không
Dialogue: 0,0:03:41.68,0:03:43.46,Original,,0,0,0,,Làm sao chị Bandasa biết được?
Dialogue: 0,0:03:45.70,0:03:46.78,Original,,0,0,0,,Ủa
Dialogue: 0,0:03:47.70,0:03:48.94,Original,,0,0,0,,Không lẽ
Dialogue: 0,0:03:49.10,0:03:50.70,Original,,0,0,0,,chuyện bọn người hầu xì xầm to nhỏ với nhau
Dialogue: 0,0:03:50.70,0:03:54.18,Original,,0,0,0,,chuyện chị là phù thủy biết sử dụng ma thuật, bùa chú là sự thật hả
Dialogue: 0,0:03:55.30,0:03:56.94,Original,,0,0,0,,Đừng có trả treo như vậy với tôi chứ tiểu thư
Dialogue: 0,0:03:57.52,0:04:00.06,Original,,0,0,0,,Tiểu thư không nên đi chơi xa\Nđến tận thác nước đó đâu
Dialogue: 0,0:04:00.40,0:04:01.58,Original,,0,0,0,,Chỗ đó nguy hiểm lắm
Dialogue: 0,0:04:03.58,0:04:05.46,Original,,0,0,0,,Ta thấy có gì nguy hiểm đâu
Dialogue: 0,0:04:06.12,0:04:08.58,Original,,0,0,0,,Chứ chị Bandasa cứ suốt ngày bắt ta ở trong phòng
Dialogue: 0,0:04:09.00,0:04:10.86,Original,,0,0,0,,Ta sẽ chết mất thôi
Dialogue: 0,0:04:12.38,0:04:13.94,Original,,0,0,0,,Nếu như phu nhân biết được chuyện này
Dialogue: 0,0:04:13.94,0:04:16.22,Original,,0,0,0,, chắc chắn bà sẽ không cho tiểu thư ra khỏi nhà nữa
Dialogue: 0,0:04:17.14,0:04:18.66,Original,,0,0,0,,Làm sao mẹ ta biết được chứ
Dialogue: 0,0:04:19.42,0:04:21.22,Original,,0,0,0,,Ngày nào bà cũng chỉ biết \Nsay sưa lựa chọn những tấm vải lụa
Dialogue: 0,0:04:21.23,0:04:25.26,Original,,0,0,0,,và những món trang sức của thương nhân đem từ Ayutthaya tới thôi à
Dialogue: 0,0:04:53.54,0:04:54.54,Original,,0,0,0,,Tiểu thư
Dialogue: 0,0:04:57.30,0:04:58.62,Original,,0,0,0,,Tiểu thư, tiểu thư đi đâu vậy ạ?
Dialogue: 0,0:05:01.40,0:05:02.98,Original,,0,0,0,,Thì ta ra ngoài chỗ thác nước chơi
Dialogue: 0,0:05:03.65,0:05:04.42,Original,,0,0,0,,Dạ thưa tiểu thư
Dialogue: 0,0:05:04.44,0:05:06.94,Original,,0,0,0,,Nếu tiểu thư định lén đi chơi nữa \Nchị Bandasa mà biết được thì sao?
Dialogue: 0,0:05:07.10,0:05:09.74,Original,,0,0,0,,Nếu ngươi không nói thì ai mà biết được chứ
Dialogue: 0,0:05:11.02,0:05:12.54,Original,,0,0,0,,Nhưng mà thưa tiểu thư
Dialogue: 0,0:05:19.54,0:05:21.26,Original,,0,0,0,,Chị, chị làm sao vậy
Dialogue: 0,0:05:22.46,0:05:23.58,Original,,0,0,0,,Thì lạ chuyện tiểu thư đó
Dialogue: 0,0:05:23.58,0:05:25.18,Original,,0,0,0,,Chắc lại lén ra chỗ thác nước chơi
Dialogue: 0,0:05:25.50,0:05:27.62,Original,,0,0,0,,Em thấy có gì đâu chứ, \Nchỉ là ra thác chơi thôi mà
Dialogue: 0,0:05:28.70,0:05:32.30,Original,,0,0,0,,Tại vì ở gần thác có một đoàn thương buôn từ Ayutthaya đến đó đóng trại
Dialogue: 0,0:05:32.88,0:05:34.54,Original,,0,0,0,,Vậy bây giờ phải làm sao đây
Dialogue: 0,0:05:34.54,0:05:37.94,Original,,0,0,0,,Lỡ có ai đó nhìn thấy tiểu thư \Nđang tắm thác thì phải làm sao
Dialogue: 0,0:06:20.90,0:06:22.02,Original,,0,0,0,,Cứu với
Dialogue: 0,0:06:24.55,0:06:25.50,Original,,0,0,0,,Cứu với
Dialogue: 0,0:07:13.30,0:07:13.70,Original,,0,0,0,,Tiểu thư
Dialogue: 0,0:07:14.10,0:07:15.14,Original,,0,0,0,,Tiểu thư
Dialogue: 0,0:07:17.10,0:07:18.50,Original,,0,0,0,,Cô thấy sao rồi
Dialogue: 0,0:07:20.68,0:07:24.02,Original,,0,0,0,,Ta...ta không sao
Dialogue: 0,0:07:28.20,0:07:31.86,Original,,0,0,0,,Ta cảm ơn chàng vì đã cứu mạng ta
Dialogue: 0,0:07:33.80,0:07:35.62,Original,,0,0,0,,Không có gì đâu
Dialogue: 0,0:07:53.54,0:07:55.22,Original,,0,0,0,,Ta...ta không sao đâu
Dialogue: 0,0:07:58.58,0:08:00.50,Original,,0,0,0,,Ta nghĩ là cô nên nghỉ một lát
Dialogue: 0,0:08:04.36,0:08:09.30,Original,,0,0,0,,Cô là ai \NNhà cô ở đâu, để ta đưa cô về
Dialogue: 0,0:08:13.00,0:08:14.10,Original,,0,0,0,,Ta tên là ...
Dialogue: 0,0:08:14.60,0:08:15.62,Original,,0,0,0,,Tiểu thư
Dialogue: 0,0:08:19.78,0:08:21.38,Original,,0,0,0,,Tiểu thư đang ở đâu vậy ạ
Dialogue: 0,0:08:27.06,0:08:28.54,Original,,0,0,0,,Tiểu thư Anilthita
Dialogue: 0,0:08:47.65,0:08:50.66,Original,,0,0,0,,Đây là phần thưởng đáp trả \Nơn ngươi đã cứu mạng tiểu thư
Dialogue: 0,0:08:56.38,0:08:59.98,Original,,0,0,0,,Xin cho ta gửi lời cầu chúc \Ncho tiểu thư mau chóng bình phục
Dialogue: 0,0:09:05.14,0:09:06.06,Original,,0,0,0,,Khoan đã
Dialogue: 0,0:09:08.58,0:09:11.38,Original,,0,0,0,,Ngươi là ai, \Ntên họ của ngươi là gì?
Dialogue: 0,0:09:14.34,0:09:15.58,Original,,0,0,0,,Ta tên là Sinthu
Dialogue: 0,0:10:13.98,0:10:17.38,Original,,0,0,0,,Đây chính là hình phạt cho các ngươi\Nvì cái tội lơ là trách nhiệm
Dialogue: 0,0:10:18.82,0:10:21.98,Original,,0,0,0,,cũng may là tiểu thư Anilthita không bị làm sao
Dialogue: 0,0:10:22.12,0:10:25.98,Original,,0,0,0,,Nếu không, các ngươi sẽ phải chết
Dialogue: 0,0:10:27.26,0:10:31.58,Original,,0,0,0,,Tôi biết lỗi rồi, \Nchị vú nuôi Bandasa hãy tha thứ cho chúng tôi đi
Dialogue: 0,0:10:31.94,0:10:33.46,Original,,0,0,0,,Biến cho khuất mắt ta ngay
Dialogue: 0,0:10:35.46,0:10:39.06,Original,,0,0,0,,Chị vú nuôi, còn những con rết trong người của chúng tôi
Dialogue: 0,0:10:39.32,0:10:40.70,Original,,0,0,0,,làm sao để lấy chúng ra đây
Dialogue: 0,0:10:41.88,0:10:43.30,Original,,0,0,0,,không chết được đâu
Dialogue: 0,0:10:44.50,0:10:47.86,Original,,0,0,0,,ta chỉ muốn các ngươi \Nnếm mùi đau đớn một chút thôi
Dialogue: 0,0:10:48.90,0:10:53.14,Original,,0,0,0,,chưa đầy hai canh giờ nữa\Nnhững con rết này sẽ tự biến mất
Dialogue: 0,0:10:53.60,0:10:55.18,Original,,0,0,0,,làm ơn đi chị ơi
Dialogue: 0,0:11:09.50,0:11:12.58,Original,,0,0,0,,Tiểu thư\NTiểu thư ra chỗ này để làm gì chứ
Dialogue: 0,0:11:12.68,0:11:14.18,Original,,0,0,0,,Lỡ chị vú nuôi biết được thì
Dialogue: 0,0:11:14.42,0:11:16.54,Original,,0,0,0,,Thì ngươi đừng nhiều chuyện để chị Bandasa biết
Dialogue: 0,0:11:16.94,0:11:19.78,Original,,0,0,0,,Ta chỉ đến đây để cảm ơn người đã cứu mạng ta thôi
Dialogue: 0,0:11:20.30,0:11:21.34,Original,,0,0,0,,Làm vậy mới phải chứ
Dialogue: 0,0:11:40.22,0:11:41.42,Original,,0,0,0,,Chàng Sinthu
Dialogue: 0,0:11:45.90,0:11:47.46,Original,,0,0,0,,Tiểu thư Anilthita
Dialogue: 0,0:11:54.44,0:11:55.66,Original,,0,0,0,,Ngươi tới cuối chợ đứng chờ ta
Dialogue: 0,0:11:56.42,0:11:56.78,Original,,0,0,0,,Nhưng mà
Dialogue: 0,0:11:57.12,0:11:57.90,Original,,0,0,0,,Cứ đi đi
Dialogue: 0,0:11:58.86,0:11:59.78,Original,,0,0,0,,Vâng ạ
Dialogue: 0,0:12:07.38,0:12:08.46,Original,,0,0,0,,Chàng hãy nhận đi
Dialogue: 0,0:12:09.46,0:12:11.50,Original,,0,0,0,,Đây là phần thưởng vì đã có ơn cứu mạng ta
Dialogue: 0,0:12:15.00,0:12:17.46,Original,,0,0,0,,Ta cứu nàng không phải để\Nmong nhận được phần thưởng
Dialogue: 0,0:12:19.90,0:12:22.02,Original,,0,0,0,,Nhưng nếu tiểu thư muốn ta nhận lấy phần thưởng
Dialogue: 0,0:12:23.54,0:12:25.86,Original,,0,0,0,,thì cho ta xin trao đổi với một thứ khác vậy
Dialogue: 0,0:12:29.50,0:12:30.82,Original,,0,0,0,,Nè, chàng dẫn ta đi đâu vậy
Dialogue: 0,0:12:51.74,0:12:53.22,Original,,0,0,0,,Đây là vải tơ tằm
Dialogue: 0,0:12:56.00,0:12:58.30,Original,,0,0,0,,là loại vải tốt nhất mà ta đang có
Dialogue: 0,0:13:29.70,0:13:32.14,Original,,0,0,0,,Thằng thương buôn ngoại lai hả, hắn to gan lắm
Dialogue: 0,0:13:32.74,0:13:33.50,Original,,0,0,0,,Dạ đúng vậy
Dialogue: 0,0:13:33.40,0:13:37.26,Original,,0,0,0,,còn tiểu thư Anilthita hình như cũng đã\Nxiêu lòng tên thương buôn đó
Dialogue: 0,0:13:42.94,0:13:45.54,Original,,0,0,0,,Ta nhất định phải giành lấy tiểu thư về tay của ta
Dialogue: 0,0:13:47.30,0:13:48.70,Original,,0,0,0,,cho dù là ai đi nữa
Dialogue: 0,0:13:48.96,0:13:51.54,Original,,0,0,0,,cũng không thể tranh giành\Nthứ mà ta để mắt tới
Dialogue: 0,0:14:02.74,0:14:04.70,Original,,0,0,0,,Tiểu thư lấy đâu ra\Ntấm vải tơ tằm đó
Dialogue: 0,0:14:05.30,0:14:06.78,Original,,0,0,0,,Thấy đẹp không chị Bandasa
Dialogue: 0,0:14:11.10,0:14:13.86,Original,,0,0,0,,Tiểu thư vừa đi đến chỗ cắm lều\Ncủa những tên thương buôn Ayutthaya đúng không
Dialogue: 0,0:14:15.22,0:14:18.74,Original,,0,0,0,,Ai ai cũng đến đó được hết\NVậy tại sao ta không thể đi chứ
Dialogue: 0,0:14:19.94,0:14:21.98,Original,,0,0,0,,Nếu cứ nghe lời chị suốt ngày ở trong nhà
Dialogue: 0,0:14:22.10,0:14:25.30,Original,,0,0,0,,thì làm sao ta có được mảnh vải này cơ chứ
Dialogue: 0,0:14:27.74,0:14:32.88,Original,,0,0,0,,Tiểu thư khen ngợi tấm vải
Dialogue: 0,0:14:29.64,0:14:32.88,Original,,0,0,0,,hay là chủ của tấm vải này hả
Dialogue: 0,0:14:35.42,0:14:38.30,Original,,0,0,0,,Chủ nhân của tấm vải \Ncũng chính là người đã cứu mạng ta
Dialogue: 0,0:14:39.44,0:14:42.38,Original,,0,0,0,,Vậy thì, tại sao ta không thể khen ngợi được
Dialogue: 0,0:14:45.82,0:14:48.02,Original,,0,0,0,,Ủa mà chị Bandasa đến tìm ta
Dialogue: 0,0:14:48.66,0:14:52.14,Original,,0,0,0,,là muốn hỏi về chuyện tấm vải \Nhay là còn chuyện nào khác nữa
Dialogue: 0,0:14:53.06,0:14:55.70,Original,,0,0,0,,Đừng có trả treo như vậy với tôi chứ tiểu thư
Dialogue: 0,0:14:58.86,0:15:00.46,Original,,0,0,0,,Dạ con chào mẹ
Dialogue: 0,0:15:02.62,0:15:04.26,Original,,0,0,0,,À mẹ có chuyện muốn nói cho con biết
Dialogue: 0,0:15:05.00,0:15:07.54,Original,,0,0,0,,Hôm nay công tử Wiriya cử người đến hỏi ý mẹ
Dialogue: 0,0:15:08.40,0:15:10.74,Original,,0,0,0,,bảo con chuẩn bị tinh thần \Nđể làm lễ thành hôn với ngài
Dialogue: 0,0:15:12.06,0:15:13.50,Original,,0,0,0,,Mẹ vừa nói gì vậy mẹ
Dialogue: 0,0:15:14.46,0:15:17.06,Original,,0,0,0,,Mẹ của tiểu thư Anilthita vui mừng khôn xiết
Dialogue: 0,0:15:17.08,0:15:21.74,Original,,0,0,0,,Bà ấy bảo là sẽ chuẩn bị mọi thứ \Nđáp ứng theo yêu cầu của công tử
Dialogue: 0,0:15:27.82,0:15:29.18,Original,,0,0,0,,Con không đồng ý
Dialogue: 0,0:15:29.92,0:15:31.74,Original,,0,0,0,,Cho dù mẹ bắt con phải chết
Dialogue: 0,0:15:32.38,0:15:36.42,Original,,0,0,0,,Con cũng tuyệt đối không chấp nhận chuyện\Nkết tóc se duyên trăm năm cùng công tử Wiriya
Dialogue: 0,0:15:36.58,0:15:38.34,Original,,0,0,0,,Tại sao con lại nói như vậy
Dialogue: 0,0:15:38.54,0:15:39.50,Original,,0,0,0,,Con có biết rằng
Dialogue: 0,0:15:39.54,0:15:40.46,Original,,0,0,0,,nếu chúng ta làm phật ý ngài
Dialogue: 0,0:15:40.46,0:15:41.86,Original,,0,0,0,,thì chuyện gì sẽ xảy ra không
Dialogue: 0,0:15:42.76,0:15:44.58,Original,,0,0,0,,Nhưng công tử Wiriya là người rất lăng nhăng
Dialogue: 0,0:15:45.12,0:15:46.90,Original,,0,0,0,,Bên cạnh ngài có hàng trăm thê thiếp nữa
Dialogue: 0,0:15:48.12,0:15:49.94,Original,,0,0,0,,Hơn nữa hắn là người tàn ác
Dialogue: 0,0:15:50.56,0:15:52.18,Original,,0,0,0,,Không thích ai thì giết người đó
Dialogue: 0,0:15:54.20,0:15:55.46,Original,,0,0,0,,Đã vậy hắn còn là tên biến thái
Dialogue: 0,0:15:56.00,0:15:59.42,Original,,0,0,0,,đã giết người ta rồi\Ncòn cắt lỗ tai làm vòng đeo trên người nữa
Dialogue: 0,0:15:59.42,0:16:00.58,Original,,0,0,0,,không có tính người gì hết
Dialogue: 0,0:16:00.88,0:16:02.38,Original,,0,0,0,,Đừng nói lớn tiếng mà Anilthita
Dialogue: 0,0:16:04.10,0:16:05.98,Original,,0,0,0,,Lỡ như một ai đó nghe được câu nói của con
Dialogue: 0,0:16:06.00,0:16:08.50,Original,,0,0,0,,thì con đừng hòng giữ được mạng sống của mình nữa
Dialogue: 0,0:16:08.94,0:16:09.74,Original,,0,0,0,,Con không sợ
Dialogue: 0,0:16:11.44,0:16:15.54,Original,,0,0,0,,Nếu như mẹ vẫn kiên quyết bắt con \Nthành hôn cùng công tử Wiriya thì con sẽ
Dialogue: 0,0:16:18.16,0:16:20.06,Original,,0,0,0,,con sẽ tìm cách quyên sinh cho mà coi
Dialogue: 0,0:16:34.90,0:16:37.86,Original,,0,0,0,,Sinthu! Sinthu!
Dialogue: 0,0:16:41.70,0:16:42.74,Original,,0,0,0,,Tiểu thư
Dialogue: 0,0:16:42.74,0:16:43.62,Original,,0,0,0,,Sinthu
Dialogue: 0,0:16:50.22,0:16:51.22,Original,,0,0,0,,Tiểu thư, đã xảy ra chuyện gì
Dialogue: 0,0:16:52.32,0:16:55.14,Original,,0,0,0,,Sinthu, bây giờ ta phải làm sao đây
Dialogue: 0,0:16:55.62,0:17:01.02,Original,,0,0,0,,công tử Wiriya cử người sang gặp mẹ để hỏi cưới ta
Dialogue: 0,0:16:58.04,0:17:01.02,Original,,0,0,0,, còn bắt ta phải làm lễ thành hôn sớm nhất có thể
Dialogue: 0,0:17:03.66,0:17:04.78,Original,,0,0,0,,người cai quản vùng đất sao
Dialogue: 0,0:17:05.30,0:17:07.82,Original,,0,0,0,,Ta tuyệt đối không bằng lòng\Nlàm vợ công tử Wiriya
Dialogue: 0,0:17:08.90,0:17:11.82,Original,,0,0,0,,Ta nhất định không chấp nhận thành hôn\Nvới người mà ta không yêu
Dialogue: 0,0:17:13.70,0:17:15.70,Original,,0,0,0,,Vậy tiểu thư có bằng lòng làm vợ ta không
Dialogue: 0,0:17:16.76,0:17:18.14,Original,,0,0,0,,Nếu chúng ta thành hôn rồi
Dialogue: 0,0:17:19.00,0:17:21.34,Original,,0,0,0,,Công tử Wiriya sẽ không làm phiền nàng nữa
Dialogue: 0,0:17:25.54,0:17:29.14,Original,,0,0,0,,Ta yêu nàng, Anilthita
Dialogue: 0,0:17:30.10,0:17:32.22,Original,,0,0,0,,Yêu từ cái nhìn đầu tiên
Dialogue: 0,0:17:33.00,0:17:34.54,Original,,0,0,0,,Yêu bằng cả trái tim
Dialogue: 0,0:17:50.00,0:17:55.24,Original,,0,0,0,,Cuộc đời ta
Dialogue: 0,0:17:52.54,0:17:55.24,Original,,0,0,0,,là do chàng cưới
Dialogue: 0,0:17:57.02,0:18:01.58,Original,,0,0,0,,Trái tim của ta
Dialogue: 0,0:17:59.08,0:18:01.58,Original,,0,0,0,,đã thuộc về chàng từ hôm đó
Dialogue: 0,0:18:43.28,0:18:45.46,Original,,0,0,0,,Công tử Wiriya là người độc ác
Dialogue: 0,0:18:46.58,0:18:49.14,Original,,0,0,0,,Ngài nhất định không buông tha\Ncho hai chúng ta đâu
Dialogue: 0,0:19:01.00,0:19:02.42,Original,,0,0,0,,Ta sẽ đưa nàng trốn đi
Dialogue: 0,0:19:04.70,0:19:06.98,Original,,0,0,0,,Nàng có chấp nhận bỏ tất cả\Nđể theo ta hay không
Dialogue: 0,0:19:12.50,0:19:13.58,Original,,0,0,0,,Tấm thân ta
Dialogue: 0,0:19:14.50,0:19:15.78,Original,,0,0,0,,Trái tim ta
Dialogue: 0,0:19:16.20,0:19:17.46,Original,,0,0,0,,đã thuộc về chàng
Dialogue: 0,0:19:18.98,0:19:20.74,Original,,0,0,0,,Bất kể chàng có đi tới nơi đâu
Dialogue: 0,0:19:21.58,0:19:23.02,Original,,0,0,0,,Ta cũng sẽ đi cùng chàng
Dialogue: 0,0:19:24.46,0:19:25.82,Original,,0,0,0,,Chúng ta phải bỏ đi càng sớm càng tốt
Dialogue: 0,0:19:26.80,0:19:28.34,Original,,0,0,0,,Trước khi mọi chuyện quá muộn màng
Dialogue: 0,0:19:30.18,0:19:31.46,Original,,0,0,0,,Ta sẽ về nhà lấy đồ đạc
Dialogue: 0,0:19:32.58,0:19:34.86,Original,,0,0,0,,rồi tối ngày mai sẽ tới đây cùng chàng bỏ trốn
Dialogue: 0,0:19:39.88,0:19:42.26,Original,,0,0,0,,vậy thì chúng ta sẽ cùng nhau bỏ trốn tới chân trời xa xôi
Dialogue: 0,0:19:42.82,0:19:45.30,Original,,0,0,0,,trốn khỏi sự thống trị của công tử Wiriya
Dialogue: 0,0:20:13.40,0:20:15.62,Original,,0,0,0,,Con gái của ngươi dám từ chối đề nghị của ta sao
Dialogue: 0,0:20:18.46,0:20:22.70,Original,,0,0,0,,Dạ thưa con gái của thần rất cảm động tấm lòng của ngài
Dialogue: 0,0:20:23.82,0:20:25.62,Original,,0,0,0,,Nhưng mà
Dialogue: 0,0:20:25.78,0:20:29.90,Original,,0,0,0,,bây giờ
Dialogue: 0,0:20:28.42,0:20:29.90,Original,,0,0,0,,nó đã có người đàn ông trong mộng rồi
Dialogue: 0,0:20:30.40,0:20:31.78,Original,,0,0,0,,To gan lắm
Dialogue: 0,0:20:34.42,0:20:36.14,Original,,0,0,0,,Vậy tên đó là ai hả?
Dialogue: 0,0:20:42.06,0:20:43.90,Original,,0,0,0,,Lều của tên Sinthu ở đâu?
Dialogue: 0,0:21:48.50,0:21:51.66,Original,,0,0,0,,Các ngươi là ai\NTại sao lại muốn giết ta?
Dialogue: 0,0:22:18.10,0:22:19.94,Original,,0,0,0,,Trước khi ngươi được chết một cách anh hùng
Dialogue: 0,0:22:20.94,0:22:22.90,Original,,0,0,0,,để ta làm phúc nói cho ngươi biết
Dialogue: 0,0:22:23.78,0:22:25.82,Original,,0,0,0,,Ta là công tử Wiriya
Dialogue: 0,0:22:27.00,0:22:31.34,Original,,0,0,0,,ngươi to gan dám yêu chung một người phụ nữ với ta, Anilthita
Dialogue: 0,0:22:32.28,0:22:36.52,Original,,0,0,0,,cho nên ngươi phải có kết cục như vậy
Dialogue: 0,0:23:01.50,0:23:07.40,Original,,0,0,0,,Tiểu thư, thưa tiểu thư\NXảy ra chuyện lớn rồi tiểu thư à
Dialogue: 0,0:23:10.98,0:23:12.22,Original,,0,0,0,,Tiểu thư
Dialogue: 0,0:23:14.18,0:23:15.90,Original,,0,0,0,,Tiểu thư à chúng ta mau quay về nhà thôi
Dialogue: 0,0:23:24.42,0:23:35.14,Original,,0,0,0,,Sinthu
Dialogue: 0,0:23:27.22,0:23:33.10,Original,,0,0,0,,Tiểu thư, tiểu thư\NVề thôi tiểu thư ơi
Dialogue: 0,0:23:35.18,0:23:36.74,Original,,0,0,0,,Tiểu thư\NĐừng đi nữa mà tiểu thư ơi
Dialogue: 0,0:23:43.58,0:23:46.14,Original,,0,0,0,,Tiểu thư à đừng đi nữa ở đây nguy hiểm lắm
Dialogue: 0,0:23:47.34,0:23:48.66,Original,,0,0,0,,Không, ngươi buông ta ra
Dialogue: 0,0:23:56.80,0:23:57.94,Original,,0,0,0,,Sinthu
Dialogue: 0,0:24:04.50,0:24:06.62,Original,,0,0,0,,Sinthu
Dialogue: 0,0:24:23.78,0:24:25.22,Original,,0,0,0,,Sinthu
Dialogue: 0,0:24:26.78,0:24:28.82,Original,,0,0,0,,Sinthu
Dialogue: 0,0:24:32.14,0:24:34.74,Original,,0,0,0,,Chàng không được có mệnh hệ gì mà Sinthu
Dialogue: 0,0:24:35.12,0:24:36.62,Original,,0,0,0,,có nghe ta nói không Sinthu
Dialogue: 0,0:24:38.10,0:24:42.42,Original,,0,0,0,,ta sẽ đưa chàng đi chữa trị
Dialogue: 0,0:24:39.84,0:24:42.42,Original,,0,0,0,,Đi thôi, đi chữa trị thôi Sinthu
Dialogue: 0,0:24:42.54,0:24:43.84,Original,,0,0,0,,Không
Dialogue: 0,0:24:50.22,0:24:55.42,Original,,0,0,0,,Đây là mặt dây chuyền, thứ mà ta trân trọng nhất
Dialogue: 0,0:24:58.10,0:25:05.42,Original,,0,0,0,,Xin trao cho nàng thay cho trái tim ta
Dialogue: 0,0:25:16.86,0:25:17.74,Original,,0,0,0,,Không
Dialogue: 0,0:25:19.30,0:25:21.46,Original,,0,0,0,,Chàng nhất định không chết mà Sinthu
Dialogue: 0,0:25:21.66,0:25:23.66,Original,,0,0,0,,chàng phải sống bên cạnh ta
Dialogue: 0,0:25:23.84,0:25:27.34,Original,,0,0,0,,chàng có nghe không\Nchàng phải sống với ta mà Sinthu
Dialogue: 0,0:25:27.34,0:25:28.98,Original,,0,0,0,,cho dù ta có chết
Dialogue: 0,0:25:31.42,0:25:33.42,Original,,0,0,0,, ta xin thề với nàng rằng
Dialogue: 0,0:25:35.62,0:25:41.82,Original,,0,0,0,,kiếp sau hay kiếp nào đi nữa\Nxin cho ta được gặp lại nàng
Dialogue: 0,0:25:44.14,0:25:52.58,Original,,0,0,0,,được nằm cùng trên chiếc giường\Nđắp chung chiếc chăn với nàng mãi mãi\NAnilthita
Dialogue: 0,0:25:57.30,0:26:04.02,Original,,0,0,0,,Ta yêu nàng
Dialogue: 0,0:26:06.50,0:26:09.70,Original,,0,0,0,,Không, Sinthu
Dialogue: 0,0:26:09.80,0:26:13.06,Original,,0,0,0,,Sinthu, đừng bỏ ta
Dialogue: 0,0:26:13.10,0:26:17.94,Original,,0,0,0,,Sinthu! Sinthu!\NĐừng bỏ ta mà
Dialogue: 0,0:26:22.50,0:26:24.34,Original,,0,0,0,,Bây giờ tên Sinthu đã chết rồi
Dialogue: 0,0:26:24.48,0:26:27.02,Original,,0,0,0,,còn mẹ của Anilthita chắc chắn \Nkhông thể trốn đi đâu được
Dialogue: 0,0:26:27.74,0:26:30.02,Original,,0,0,0,,dù người yêu của tiểu thư Anilthita qua đời rồi
Dialogue: 0,0:26:30.02,0:26:34.46,Original,,0,0,0,,nhưng tiểu thư Anilthita vẫn kiên quyết\Ntừ chối làm lễ thành hôn với công tử
Dialogue: 0,0:26:38.20,0:26:39.90,Original,,0,0,0,,nếu gan to thì cứ thử làm đi
Dialogue: 0,0:26:40.50,0:26:43.14,Original,,0,0,0,,mặc dù ả là con gái của quan lớn
Dialogue: 0,0:26:43.84,0:26:45.86,Original,,0,0,0,,nhưng cha của ả đã qua đời lâu rồi
Dialogue: 0,0:26:46.26,0:26:48.10,Original,,0,0,0,,ả chỉ sống với một người mẹ già thôi
Dialogue: 0,0:26:48.50,0:26:50.94,Original,,0,0,0,,sao dám từ chối lời đề nghị\Ncủa một người quyền lực như ta chứ
Dialogue: 0,0:26:51.62,0:26:53.14,Original,,0,0,0,,cử người đi nói với tiểu thư Anilthita
Dialogue: 0,0:26:54.00,0:26:55.98,Original,,0,0,0,,nếu ả dám từ chối làm lễ thành hôn cùng ta
Dialogue: 0,0:26:56.62,0:27:00.18,Original,,0,0,0,,mẹ già của ả sẽ có kết thúc như tên Sinthu kia
Dialogue: 0,0:27:25.98,0:27:28.02,Original,,0,0,0,,Ta...xin trao cho nàng
Dialogue: 0,0:27:29.08,0:27:30.26,Original,,0,0,0,,trái tim của ta
Dialogue: 0,0:29:06.54,0:29:07.54,Original,,0,0,0,,Đi đi con
Dialogue: 0,0:29:08.42,0:29:11.66,Original,,0,0,0,,đoàn tùy tùng của công tử Wiriya\Nđã đến đây để đón con rồi đó
Dialogue: 0,0:29:12.28,0:29:13.50,Original,,0,0,0,,họ chờ lâu rồi
Dialogue: 0,0:30:59.34,0:31:00.54,Original,,0,0,0,,Ra ngoài
Dialogue: 0,0:31:02.54,0:31:03.54,Original,,0,0,0,,Ra ngoài
Dialogue: 0,0:31:28.08,0:31:29.46,Original,,0,0,0,,Nàng quả thật rất đẹp
Dialogue: 0,0:31:32.56,0:31:34.02,Original,,0,0,0,,lần đầu tiên gặp nàng
Dialogue: 0,0:31:34.52,0:31:35.54,Original,,0,0,0,,dù là ở khoảng cách xa
Dialogue: 0,0:31:38.46,0:31:40.42,Original,,0,0,0,,Ta đã thấy nàng rất đẹp rồi
Dialogue: 0,0:31:43.70,0:31:45.50,Original,,0,0,0,,Bây giờ khi ta được ngắm nàng gần hơn
Dialogue: 0,0:31:47.30,0:31:48.54,Original,,0,0,0,,thì ta biết là
Dialogue: 0,0:31:49.70,0:31:52.98,Original,,0,0,0,,là nàng đẹp ở từng đường nét
Dialogue: 0,0:32:58.82,0:33:04.60,Original,,0,0,0,,đây chính là sự trả thù\Ncho người yêu đã chết của ta
Dialogue: 0,0:33:28.16,0:33:28.94,Original,,0,0,0,,Tiểu thư
Dialogue: 0,0:33:30.18,0:33:31.98,Original,,0,0,0,,Tiểu thư đã gây ra chuyện gì vậy
Dialogue: 0,0:33:33.54,0:33:36.10,Original,,0,0,0,,Chạy đi tiểu thư\NTrước khi mọi người nhìn thấy
Dialogue: 0,0:33:36.22,0:33:37.82,Original,,0,0,0,,mau đi tiểu thư
Dialogue: 0,0:33:40.66,0:33:41.70,Original,,0,0,0,,Khoan đã
Dialogue: 0,0:33:53.42,0:33:55.50,Original,,0,0,0,,Tiểu thư,\Nđi thôi
Dialogue: 0,0:34:14.34,0:34:15.86,Original,,0,0,0,,Đi thôi tiểu thư à
Dialogue: 0,0:34:44.78,0:34:46.22,Original,,0,0,0,,công tử bị nàng ta sát hại rồi
Dialogue: 0,0:34:46.30,0:34:47.42,Original,,0,0,0,,mau lệnh cho quân lính\Ntruy tìm bọn chúng
Dialogue: 0,0:34:50.22,0:34:53.54,Original,,0,0,0,,quân lính đâu\Nmau truy tìm tiểu thư Anilthita đi
Dialogue: 0,0:34:54.78,0:34:55.46,Original,,0,0,0,,mau lên
Dialogue: 0,0:34:57.06,0:34:58.74,Original,,0,0,0,,lính đâu\Nlính đâu
Dialogue: 0,0:34:59.86,0:35:00.70,Original,,0,0,0,,theo ta
Dialogue: 0,0:35:21.96,0:35:23.26,Original,,0,0,0,,Bắt lấy chúng
Dialogue: 0,0:35:28.82,0:35:31.18,Original,,0,0,0,,Tiểu thư,\Nngười thế nào rồi
Dialogue: 0,0:35:35.06,0:35:36.82,Original,,0,0,0,,Chị Bandasa\Nchân của ta
Dialogue: 0,0:35:37.82,0:35:40.78,Original,,0,0,0,,chắc là không đi được nữa rồi\Nchị Bandasa
Dialogue: 0,0:35:57.26,0:35:58.26,Original,,0,0,0,,Tiểu thư à
Dialogue: 0,0:35:58.50,0:35:59.46,Original,,0,0,0,,Tiểu thư trốn ở đây đi nha
Dialogue: 0,0:36:00.30,0:36:01.86,Original,,0,0,0,,để tôi ra ngoài ngăn cản bọn chúng
Dialogue: 0,0:36:02.38,0:36:03.54,Original,,0,0,0,,chị Bandasa
Dialogue: 0,0:36:04.42,0:36:09.06,Original,,0,0,0,,bọn chúng kéo tới đông như vậy, đã vậy còn có vũ khí nữa làm sao chị chống nổi bọn chúng chứ
Dialogue: 0,0:36:10.48,0:36:13.22,Original,,0,0,0,,chị Bandasa\Nchị Bandasa
Dialogue: 0,0:36:27.48,0:36:29.18,Original,,0,0,0,,bọn ngươi tưởng sẽ thoát được hay sao hả
Dialogue: 0,0:36:30.44,0:36:33.18,Original,,0,0,0,,mau nói đi\Ntiểu thư Anilthita đang ở đâu hả
Dialogue: 0,0:36:35.62,0:36:37.90,Original,,0,0,0,,đừng hỏi nhiều\Nmau bắt lấy bà ta đi
Dialogue: 0,0:36:54.20,0:36:56.30,Original,,0,0,0,,ngươi là người có ma thuật sao
Dialogue: 0,0:36:57.10,0:36:58.02,Original,,0,0,0,,Tốt!
Dialogue: 0,0:37:15.50,0:37:16.70,Original,,0,0,0,,Chị Bandasa
Dialogue: 0,0:37:34.26,0:37:35.74,Original,,0,0,0,,Bây giờ tới lượt ta
Dialogue: 0,0:38:01.77,0:38:02.97,Original,,0,0,0,,Chị Bandasa
Dialogue: 0,0:38:03.94,0:38:05.14,Original,,0,0,0,,Chuyện này là sao vậy
Dialogue: 0,0:38:05.74,0:38:07.30,Original,,0,0,0,,Tại sao chị có thể làm như vậy được
Dialogue: 0,0:38:08.90,0:38:10.94,Original,,0,0,0,,Tạm thời tiểu thư đừng hỏi gì hết
Dialogue: 0,0:38:11.42,0:38:12.98,Original,,0,0,0,,Bây giờ chúng ta mau chạy trốn thôi
Dialogue: 0,0:38:13.00,0:38:15.86,Original,,0,0,0,,Ngọn lửa tà này chỉ cầm chân bọn chúng được một lúc thôi
Dialogue: 0,0:38:19.10,0:38:22.22,Original,,0,0,0,,Đi\NĐi thôi tiểu thư
Dialogue: 0,0:38:49.12,0:38:50.62,Original,,0,0,0,,Bây giờ tạm thời chúng ta\Nsẽ trốn ở đây để lánh nạn
Dialogue: 0,0:38:52.00,0:38:53.82,Original,,0,0,0,,Vậy nếu lỡ bọn chúng tìm tới đây thì sao chị
Dialogue: 0,0:39:32.86,0:39:33.62,Original,,0,0,0,,Chị
Dialogue: 0,0:39:34.38,0:39:36.34,Original,,0,0,0,,Chị Bandasa
Dialogue: 0,0:39:37.20,0:39:39.34,Original,,0,0,0,,Chị đúng là phù thủy ma thuật như lời đồn của mọi người
Dialogue: 0,0:39:41.66,0:39:42.70,Original,,0,0,0,,Tiểu thư
Dialogue: 0,0:39:45.06,0:39:47.74,Original,,0,0,0,,Tiểu thư!\NTiểu thư đừng sợ tôi mà
Dialogue: 0,0:39:49.86,0:39:52.70,Original,,0,0,0,,Tôi chỉ là đang dùng ma thuật\Nđể phòng thân mà thôi
Dialogue: 0,0:39:54.02,0:39:56.94,Original,,0,0,0,,phải rồi,\Nlúc nãy chị bị chém
Dialogue: 0,0:39:58.82,0:39:59.86,Original,,0,0,0,,vết thương đó
Dialogue: 0,0:40:01.54,0:40:03.26,Original,,0,0,0,,vết thương của chị đã biến mất rồi
Dialogue: 0,0:40:04.20,0:40:05.58,Original,,0,0,0,,chị
Dialogue: 0,0:40:06.66,0:40:09.62,Original,,0,0,0,,Tiểu thư à,\Ntiểu thư đang bị thương đó
Dialogue: 0,0:40:09.80,0:40:11.62,Original,,0,0,0,,mau mau nghỉ ngơi đi
Dialogue: 0,0:40:11.62,0:40:13.90,Original,,0,0,0,,ta nghe bọn người hầu trong nhà bàn tán to nhỏ
Dialogue: 0,0:40:14.64,0:40:16.86,Original,,0,0,0,,là chị Bandasa có ma thuật bùa chú
Dialogue: 0,0:40:17.84,0:40:22.38,Original,,0,0,0,,không già, cũng không chết\Nnhưng mà ta lại không tin
Dialogue: 0,0:40:23.74,0:40:26.02,Original,,0,0,0,,mãi đến hôm nay mới được tận mắt chứng kiến
Dialogue: 0,0:40:27.06,0:40:30.70,Original,,0,0,0,,Tiểu thư à,\Ncô tạm thời đừng thắc mắc gì về tôi nữa
Dialogue: 0,0:40:32.50,0:40:34.74,Original,,0,0,0,,Bên kia có một con suối
Dialogue: 0,0:40:35.54,0:40:39.62,Original,,0,0,0,,Tiểu thư mau đi rửa mặt và tay chân đi\Nngày mai chúng ta còn phải đi rất xa đó
Dialogue: 0,0:41:24.06,0:41:25.58,Original,,0,0,0,,Tiểu thư à
Dialogue: 0,0:41:27.70,0:41:31.18,Original,,0,0,0,,Ta chính là nguyên nhân khiến cho Sinthu phải chết
Dialogue: 0,0:41:33.48,0:41:35.78,Original,,0,0,0,,Đừng tự trách bản thân của mình nữa tiểu thư
Dialogue: 0,0:41:36.92,0:41:39.38,Original,,0,0,0,,Phước của cậu ta chỉ tới đây thôi
Dialogue: 0,0:41:40.00,0:41:44.58,Original,,0,0,0,,Tiểu thư cứ xem như là tiểu thư và cậu ta không có duyên nợ với nhau đi
Dialogue: 0,0:41:45.90,0:41:46.82,Original,,0,0,0,,Không đâu
Dialogue: 0,0:41:49.26,0:41:50.94,Original,,0,0,0,,chàng đã cứu mạng ta
Dialogue: 0,0:41:53.14,0:41:55.34,Original,,0,0,0,,Chàng chính là tri kỉ của ta
Dialogue: 0,0:41:57.86,0:42:00.98,Original,,0,0,0,,Trước khi chết chàng vẫn còn thề
Dialogue: 0,0:42:02.58,0:42:05.86,Original,,0,0,0,,xin được kết duyên cùng ta ở kiếp sau
Dialogue: 0,0:42:08.18,0:42:13.22,Original,,0,0,0,,kiếp sau sẽ được sinh ra như thế nào\Nvà số phận của mỗi người ra sao
Dialogue: 0,0:42:13.22,0:42:15.06,Original,,0,0,0,,làm sao chúng ta biết được chứ
Dialogue: 0,0:42:24.58,0:42:25.58,Original,,0,0,0,,phải rồi
Dialogue: 0,0:42:27.06,0:42:29.18,Original,,0,0,0,,Nếu như Sinthu được đầu thai kiếp sau
Dialogue: 0,0:42:29.64,0:42:32.94,Original,,0,0,0,,nếu ta không chết chắc ta sẽ già và xấu xí lắm
Dialogue: 0,0:42:33.56,0:42:35.30,Original,,0,0,0,,vậy làm sao mà ta kết duyên cùng chàng được
Dialogue: 0,0:42:36.30,0:42:39.34,Original,,0,0,0,,Chị Bandasa\Nchị hãy mau giúp ta đi
Dialogue: 0,0:42:40.26,0:42:44.86,Original,,0,0,0,,Chị hãy dạy phép thuật cho ta để ta không biết thế nào là đau, thế nào là chết giống như chị đi
Dialogue: 0,0:42:47.14,0:42:48.34,Original,,0,0,0,,Không!
Dialogue: 0,0:42:48.94,0:42:50.02,Original,,0,0,0,,Tại sao chứ
Dialogue: 0,0:42:51.00,0:42:53.66,Original,,0,0,0,,Phép thuật của tôi là phép thuật tà ác tiểu thư à
Dialogue: 0,0:42:54.28,0:42:55.70,Original,,0,0,0,,Nếu như có ai học phép thuật này
Dialogue: 0,0:42:55.90,0:42:58.58,Original,,0,0,0,,bàn tay của người đó sẽ dính không biết bao nhiêu là máu
Dialogue: 0,0:42:58.80,0:43:00.90,Original,,0,0,0,,nhưng bây giờ tay của ta đã dính máu rồi mà
Dialogue: 0,0:43:01.68,0:43:03.34,Original,,0,0,0,,Ta đã giết công tử Wiriya
Dialogue: 0,0:43:04.14,0:43:08.34,Original,,0,0,0,,Nếu như ta chết đi \Nthì cũng bị đày xuống 18 tầng địa ngục thôi
Dialogue: 0,0:43:10.36,0:43:13.06,Original,,0,0,0,,nếu như bàn tay của ta phải dính máu thêm một lần nữa
Dialogue: 0,0:43:13.70,0:43:15.74,Original,,0,0,0,,để ta được gặp Sinthu
Dialogue: 0,0:43:16.74,0:43:18.30,Original,,0,0,0,,thì ta cũng cam lòng
Dialogue: 0,0:43:19.70,0:43:21.62,Original,,0,0,0,,Nhưng mà không chỉ là một hai lần đâu
Dialogue: 0,0:43:22.14,0:43:23.58,Original,,0,0,0,,mà là mãi mãi
Dialogue: 0,0:43:24.46,0:43:27.34,Original,,0,0,0,,Tôi rất thương tiểu thư\NTôi không muốn nhìn thấy tiểu thư bị như vậy đâu
Dialogue: 0,0:43:29.90,0:43:31.58,Original,,0,0,0,,Nhưng ta yêu Sinthu
Dialogue: 0,0:43:33.14,0:43:39.34,Original,,0,0,0,,Nếu như ta sống mà không có chàng bên cạnh thì cũng giống như đã chết
Dialogue: 0,0:43:40.54,0:43:45.94,Original,,0,0,0,,Chị Bandasa \Nxin chị hãy giúp ta
Dialogue: 0,0:43:46.98,0:43:51.78,Original,,0,0,0,,Chị Bandasa \Ngiúp ta với
Dialogue: 0,0:43:52.66,0:43:59.82,Original,,0,0,0,,Hãy truyền phép thuật lại cho ta\NHãy truyền phép thuật lại cho ta đi chị Bandasa, ta xin chị
Dialogue: 0,0:44:01.10,0:44:04.74,Original,,0,0,0,,Hãy dạy ta đi, \Nhãy chỉ cho ta
Dialogue: 0,0:44:05.54,0:44:06.86,Original,,0,0,0,,Không được
Dialogue: 0,0:44:10.00,0:44:16.78,Original,,0,0,0,,Nếu như chị không dạy ta \Nta cũng không thiết phải sống tiếp để làm gì
Dialogue: 0,0:44:21.32,0:44:22.90,Original,,0,0,0,,Tiểu thư! Tiểu thư
Dialogue: 0,0:44:24.54,0:44:27.62,Original,,0,0,0,,Tiểu thư, \NBỏ ra! \NĐừng làm vậy mà
Dialogue: 0,0:44:28.98,0:44:31.90,Original,,0,0,0,,Tiểu thư à, tôi xem tiểu thư như là em gái của tôi
Dialogue: 0,0:44:31.90,0:44:34.22,Original,,0,0,0,,Tôi không thể để tiểu thư chết được
Dialogue: 0,0:44:35.10,0:44:36.90,Original,,0,0,0,,Vậy thì chị hãy dạy cho ta đi
Dialogue: 0,0:44:38.94,0:44:41.78,Original,,0,0,0,,Hãy chỉ cho ta cách trường sinh bất lão giống như chị đi
Dialogue: 0,0:44:42.90,0:44:45.86,Original,,0,0,0,,để ta không già, không chết
Dialogue: 0,0:44:47.34,0:44:49.78,Original,,0,0,0,,bất kể thời gian có trôi qua như thế nào đi nữa
Dialogue: 0,0:44:50.94,0:44:55.90,Original,,0,0,0,,để cho ta có thể gặp lại Sinthu \Nkhi chàng đầu thai kiếp sau
Dialogue: 0,0:46:23.60,0:46:25.66,Original,,0,0,0,,Phương pháp tắm trong dòng nước thánh
Dialogue: 0,0:46:25.66,0:46:28.14,Original,,0,0,0,,để giữ nét thanh xuân theo thời gian
Dialogue: 0,0:46:28.54,0:46:30.74,Original,,0,0,0,,phải được thực hiện vào đêm trăng rằm
Dialogue: 0,0:46:31.50,0:46:34.58,Original,,0,0,0,,bằng cách sử dụng máu tươi \Ncủa thanh niên cường tráng
Dialogue: 0,0:46:35.32,0:46:40.26,Original,,0,0,0,,hòa trộn với các loại thoại dược \Nvà niệm những câu thần chú bí ẩn
Dialogue: 0,0:48:38.72,0:48:40.46,Original,,0,0,0,,Xong rồi tiểu thư
Dialogue: 0,0:49:34.34,0:49:36.50,Original,,0,0,0,,Sau khi ngâm mình trong dòng nước thánh
Dialogue: 0,0:49:36.50,0:49:39.70,Original,,0,0,0,,đồng thời trong miệng luôn niệm câu thần chú
Dialogue: 0,0:49:39.90,0:49:46.70,Original,,0,0,0,,làn da nhăn nheo xấu xí sẽ trở nên trắng trẻo mịn màng như tuổi thanh xuân
